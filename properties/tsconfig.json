{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"incremental": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"outDir": "../build",
		"rootDir": "../",
		"strict": true,
		"sourceMap": true,
		"target": "ES2022",
		"types": [
			"node"
		]
	},
	"include": [
		"../src/**/*.ts"
	],
	"types": [
		"node",
		"electron"
	]
}
